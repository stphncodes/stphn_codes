# Public URL of the deployed site. Used for canonical URLs, Open Graph tags,
# the sitemap and robots.txt. Leave unset locally.
NEXT_PUBLIC_SITE_URL=https://example.com

# Where project inquiries and contact messages are delivered.
# Defaults to stphncodes@gmail.com when unset.
INQUIRY_TO_EMAIL=stphncodes@gmail.com

# Optional: deliver form submissions by email through Resend (https://resend.com).
# When RESEND_API_KEY is unset the form falls back to opening a prefilled
# email draft in the visitor's mail client and tells them so.
RESEND_API_KEY=
# Sender address for Resend. Must be on a domain verified in your Resend account.
INQUIRY_FROM_EMAIL=StphnCodes Studio <inquiries@example.com>

# Optional alternative: forward submissions as JSON to any webhook
# (Zapier, Make, n8n, your own endpoint). Used only when RESEND_API_KEY is unset.
INQUIRY_WEBHOOK_URL=
